# Vercel local link only — do NOT ignore `.vercel/output` (Build Output API).
# Ignoring `.vercel/*` made Vercel skip Build Output API and demand `public`.
.vercel/project.json
.vercel/README.txt

# Env / secrets
.env
.env.*
!.env.example

# Vite intermediate (copied into .vercel/output / public by build:vercel)
