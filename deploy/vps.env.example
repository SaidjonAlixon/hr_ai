# VPS: shu faylni loyiha ildiziga `.env` nomi bilan nusxa qiling:  cp deploy/vps.env.example .env && chmod 600 .env
# Vercel → Settings → Environment Variables dagi qiymatlarni AYNAN ko‘chiring (ayniqsa SESSION_SECRET / FACE_DESCRIPTOR_KEY).

NODE_ENV=production
PORT=8080
TZ=Asia/Tashkent

# Lokal Postgres (setup-server.sh yaratadi). sslmode=disable — baza shu serverning ichida.
DATABASE_URL=postgresql://hr:PAROL@127.0.0.1:5432/hr?sslmode=disable

# Yangi domen (HTTPS majburiy — Telegram Mini App, push, Face ID)
PUBLIC_APP_URL=https://hr.example.uz

# MUHIM: Vercel’dagi bilan bir xil bo‘lsin. Face ID vektorlari shu kalit bilan shifrlangan —
# boshqa qiymat qo‘ysangiz barcha yuz profillari ochilmaydi va qayta ro‘yxatdan o‘tish kerak bo‘ladi.
# Vercel’da bo‘sh bo‘lsa — bu yerda ham bo‘sh qoldiring.
SESSION_SECRET=
FACE_DESCRIPTOR_KEY=

# Telegram webhook/setup himoyasi (openssl rand -hex 32)
CRON_SECRET=
TELEGRAM_SETUP_SECRET=

# Telegram HR bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Telegram filial (lokatsiya) bot
TELEGRAM_FILIAL_BOT_TOKEN=
TELEGRAM_FILIAL_WEBHOOK_SECRET=
TELEGRAM_FILIAL_ADMIN_IDS=
TELEGRAM_FILIAL_RECRUITER_IDS=
# 1 qilsangiz webhook o‘rniga polling (domen/HTTPS bo‘lmasa). Webhook tavsiya etiladi.
TELEGRAM_FILIAL_POLLING=0

# Web Push (brauzer bildirishnomalari) — Vercel’dagi kalitlar
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# OpenAI (Face tasdiq, yordamchi, nomzod tahlili)
OPENAI_API_KEY=
# OPENAI_FACE_MODEL=gpt-4o
# FACE_AI_VERIFY=1

# Vercel Blob’dagi eski fayllar ochilishi uchun tokenni qoldiring.
# Bo‘sh qoldirilsa yangi fayllar artifacts/api-server/uploads/ ga yoziladi (backup-db.sh zaxiralaydi).
# BLOB_READ_WRITE_TOKEN=

# VaksinaMed integratsiyasi (Vercel’da bo‘lsa)
# VAKSINAMED_BASE_URL=
# VAKSINAMED_API_KEY=
# VAKSINAMED_DEFAULT_USERNAME=
# VAKSINAMED_USER_MAP=

LOG_LEVEL=info

# 0 — fon ishlari (eslatmalar, eskalatsiya) o‘chiq. Faqat sinov paytida, Vercel hali ishlayotganda.
# Haqiqiy ko‘chishdan keyin 1 qiling yoki qatorni o‘chiring.
BACKGROUND_JOBS=1
