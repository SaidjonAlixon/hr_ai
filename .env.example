# Copy to .env for local; set the same keys in Vercel → Project → Settings → Environment Variables

# Required — Postgres connection string (Neon / Supabase / Vercel Postgres)
# Example Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional — cookie signing / session hardening
SESSION_SECRET=change-me-in-production

# Optional — protect Vercel Cron endpoint /api/jobs/vacancy-reminders
# Generate: openssl rand -hex 32
# Also add the same value in Vercel → Settings → Cron Jobs (Authorization uses Bearer)
CRON_SECRET=

# Optional — Vercel Blob (vazifa/eslatma fayllari). Vercel → Storage → Blob → token
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Token bo‘lmasa local `uploads/` papkasiga saqlanadi va /api/uploads/... orqali beriladi

# Face ID — face-api.js 128-d FaceNet (L2). Login dist≤0.34 & cosine≥0.942
# Duplicate enroll block dist≤0.48 (boshqa accountga yaqin yuz)
# FACE_MATCH_THRESHOLD=0.34
# FACE_ENROLLMENT_THRESHOLD=0.48
# FACE_MATCH_MIN_COSINE=0.942
# LIVENESS_THRESHOLD=0.55
# FACE_DESCRIPTOR_KEY=  # AES-GCM; bo‘lmasa SESSION_SECRET
# Face ID rasmlari Neon face_profiles.photo_url (data URL) da saqlanadi

# OpenAI Vision — enroll + login tasdiq (kalit faqat backend .env / Vercel)
# OPENAI_API_KEY=
# OPENAI_FACE_MODEL=gpt-4o
# FACE_AI_VERIFY=1
# FACE_AI_TIMEOUT_MS=20000

# Local Vite only
# PORT=26253
# BASE_PATH=/
# API_PROXY_TARGET=http://127.0.0.1:8080

# Telegram bot + Mini App
# BotFather → /newbot → token
TELEGRAM_BOT_TOKEN=
# Production URL (HTTPS) — Mini App va webhook uchun
PUBLIC_APP_URL=https://hr-ai-gamma.vercel.app
# Ixtiyoriy — webhook himoya (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# Ixtiyoriy — POST /api/telegram/setup uchun (CRON_SECRET ham ishlaydi)
# TELEGRAM_SETUP_SECRET=
